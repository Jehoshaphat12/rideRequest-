{
  "expo": {
    "name": "RideX",
    "slug": "rideRequest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riderequest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAS2zZ-Vm9MrElzJiAUY6h1VWQPJc9vMgM"
      },
      "bundleIdentifier": "com.jehoshaphat12.rideRequest",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jehoshaphat12.rideRequest",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAS2zZ-Vm9MrElzJiAUY6h1VWQPJc9vMgM"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon1.png",
          "imageWidth": "100%",
          "imageHeight": "100%",
          "resizeMode": "contain",
          "backgroundColor": "#7500fc",
          "dark": {
            "backgroundColor": "#7500fc",
            "image": "./assets/images/splash-icon1.png"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a17d6a9-a9ec-45f2-89c4-4cbdc78e1e0e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a17d6a9-a9ec-45f2-89c4-4cbdc78e1e0e"
    }
  }
}
